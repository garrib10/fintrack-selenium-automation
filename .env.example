# Required: production, staging, or local. Production is never assumed, so
# browser tests refuse to start until this is set deliberately.
export FINTRACK_TARGET_ENV='replace-with-production-staging-or-local'
# Optional for production (defaults to the deployed URL); required for staging and local,
# e.g. https://<your-staging-host> or http://localhost:5173.
export FINTRACK_BASE_URL='https://finance-operations-dashboard.vercel.app'
# Staging only, when Vercel Authentication protects the deployment. Use one:
# a share link (or just its _vercel_share token) from Vercel's Share button,
# or a Protection Bypass for Automation secret (preferred for CI).
# export FINTRACK_VERCEL_SHARE_TOKEN='replace-with-share-link-or-token'
# export FINTRACK_VERCEL_BYPASS_SECRET='replace-with-bypass-secret'
# Automation account for production and local runs.
export FINTRACK_TEST_EMAIL='replace-with-dedicated-test-email'
export FINTRACK_TEST_PASSWORD='replace-with-dedicated-test-password'
# Separate automation account for staging runs (staging has its own database).
export FINTRACK_STAGING_EMAIL='replace-with-staging-test-email'
export FINTRACK_STAGING_PASSWORD='replace-with-staging-test-password'
export FINTRACK_ALLOW_REGISTRATION='false'
export FINTRACK_TEST_BUDGET_CATEGORY='Travel'
export FINTRACK_HEADLESS='false'
